          "stringUnit" : {
            "state" : "translated",
            "value" : "Mỗi khi địa chỉ đổi sẽ ghi thêm một dòng; có thể bật thông báo trong Cài đặt › Mạng."
          }
        }
      }
    },
    "A plain TCP connection to each port, nothing more. Only check hosts you are allowed to test." : {
      "localizations" : {
