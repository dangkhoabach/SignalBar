    },
    "No sources yet. A router read over SNMP shows the devices of every VLAN it routes, with their MAC addresses; a DHCP server shows who was given which address." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chưa có nguồn nào. Router đọc qua SNMP cho thấy thiết bị của mọi VLAN nó định tuyến, kèm địa chỉ MAC; máy chủ DHCP cho thấy ai được cấp địa chỉ nào."
          }
        }
      }
    },
