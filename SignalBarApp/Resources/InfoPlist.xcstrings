    "NSLocalNetworkUsageDescription" : {
      "comment" : "Shown by macOS when SignalBar first reaches a device on the local network.",
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SignalBar tìm các thiết bị trong những mạng bạn thêm ở mục Mạng, và đọc router, switch, máy chủ DHCP bạn thiết lập ở đó."
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "comment" : "Shown by macOS when the user asks SignalBar to show the Wi-Fi network's name.",
      "extractionState" : "manual",
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS chỉ cho ứng dụng có quyền Vị trí xem tên mạng Wi‑Fi. SignalBar không dùng quyền này vào việc gì khác."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
