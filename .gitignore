*.xcodeproj/*
!*.xcodeproj/project.pbxproj
*.xcuserstate
xcuserdata/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
